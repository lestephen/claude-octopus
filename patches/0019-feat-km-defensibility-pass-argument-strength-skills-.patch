++++diff --git a/patches/0005-fix-commands-prevent-self-referential-symlink-in-oct.patch b/patches/0005-fix-commands-prevent-self-referential-symlink-in-oct.patch
++++new file mode 100644
++++index 0000000..d11e022
++++--- /dev/null
+++++++ b/patches/0005-fix-commands-prevent-self-referential-symlink-in-oct.patch
++++@@ -0,0 +1,34 @@
+++++From 62d985eaa5a380d6fc2e72e65af3a0dd86f47fb1 Mon Sep 17 00:00:00 2001
+++++From: lestephen <30328443+lestephen@users.noreply.github.com>
+++++Date: Sat, 16 May 2026 12:19:20 -0700
+++++Subject: [PATCH 5/8] fix(commands): prevent self-referential symlink in
+++++ /octo:doctor resolver
+++++
+++++The resolver overwrote ~/.claude-octopus/plugin with itself when
+++++OCTO_PLUGIN_ROOT was already the symlink path, breaking the link
+++++and causing 'too many levels of symbolic links' on subsequent runs.
+++++Now resolve canonical paths via readlink -f and skip ln when source
+++++and destination already point to the same target.
+++++
+++++diff --git a/.claude/commands/doctor.md b/.claude/commands/doctor.md
+++++index 6bb6bc5..3b786fa 100644
+++++--- a/.claude/commands/doctor.md
++++++++ b/.claude/commands/doctor.md
+++++@@ -39,7 +39,13 @@ if [[ -z "$OCTO_PLUGIN_ROOT" || ! -x "$OCTO_PLUGIN_ROOT/scripts/orchestrate.sh"
+++++   exit 1
+++++ fi
+++++ mkdir -p "${HOME}/.claude-octopus"
+++++-ln -sfn "$OCTO_PLUGIN_ROOT" "${HOME}/.claude-octopus/plugin" 2>/dev/null || true
++++++# Resolve to a canonical path so we never create a self-referential symlink
++++++# when OCTO_PLUGIN_ROOT already IS ~/.claude-octopus/plugin (a working symlink).
++++++OCTO_PLUGIN_REAL="$(readlink -f "$OCTO_PLUGIN_ROOT" 2>/dev/null || echo "$OCTO_PLUGIN_ROOT")"
++++++OCTO_LINK_REAL="$(readlink -f "${HOME}/.claude-octopus/plugin" 2>/dev/null || echo "")"
++++++if [[ "$OCTO_PLUGIN_REAL" != "$OCTO_LINK_REAL" ]]; then
++++++  ln -sfn "$OCTO_PLUGIN_REAL" "${HOME}/.claude-octopus/plugin" 2>/dev/null || true
++++++fi
+++++ export OCTO_PLUGIN_ROOT
+++++ cd "$OCTO_PLUGIN_ROOT" && bash scripts/orchestrate.sh doctor --verbose
+++++ ```
+++++-- 
