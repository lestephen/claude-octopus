From 1c34462ae2645e7ac7a7b0a6e3c570d51939760c Mon Sep 17 00:00:00 2001
From: lestephen <30328443+lestephen@users.noreply.github.com>
Date: Sat, 16 May 2026 11:57:21 -0700
Subject: [PATCH 03/21] feat(orchestrate): PROJECT_ROOT fallback when cwd is a
 plugin install dir

orchestrate.sh captured PROJECT_ROOT=${PWD} unconditionally, so callers
that cd into the plugin dir before invocation broke downstream agent
spawning (spawn.sh does 'cd "$PROJECT_ROOT"' before each agent and
Gemini auto-detected its workspace as the plugin dir, refusing writes
to the actual project).

Belt-and-suspenders for the .claude command fix: even if a future
caller forgets and re-introduces the cd-pattern, PROJECT_ROOT now
detects plugin-cache paths and falls back to $OLDPWD. Explicit
OCTOPUS_PROJECT_DIR override added for callers that want to be
fully unambiguous.

diff --git a/scripts/orchestrate.sh b/scripts/orchestrate.sh
index efb40a4..03d5fea 100755
--- a/scripts/orchestrate.sh
+++ b/scripts/orchestrate.sh
@@ -62,7 +62,18 @@ fi
 OCTOPUS_DEBUG="${OCTOPUS_DEBUG:-false}"
 
 # Workspace location - uses home directory for global installation
-PROJECT_ROOT="${PWD}"
+# Priority: OCTOPUS_PROJECT_DIR env var > $PWD > $OLDPWD (when $PWD is a
+# plugin-cache install dir, which can happen if a caller cd'd into the
+# plugin before invoking this script — historical pattern in the .claude
+# command markdown files prior to v9.38.0-petrics.1).
+PROJECT_ROOT="${OCTOPUS_PROJECT_DIR:-${PWD}}"
+case "$PROJECT_ROOT" in
+    */.claude/plugins/cache/*|*/.claude-octopus/plugin*)
+        if [[ -n "${OLDPWD:-}" ]]; then
+            PROJECT_ROOT="$OLDPWD"
+        fi
+        ;;
+esac
 
 # Source state manager utilities
 source "${SCRIPT_DIR}/state-manager.sh"
