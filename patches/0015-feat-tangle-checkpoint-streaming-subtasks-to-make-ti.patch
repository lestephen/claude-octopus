+# Build the checkpoint-protocol header that gets prepended to each tangle
+# subtask. Forces models to materialize work as incremental apply_patches
+# rather than holding it all in their response stream until the very end —
+# which is what made the v9.38.0-lestephen.6 PR-2 tangle run lose 100% of
+# 10 minutes of Codex generation when the timeout fired.
+#
+# Toggle off with OCTOPUS_TANGLE_CHECKPOINTS=false for the legacy behavior.
+_tangle_checkpoint_protocol_header() {
+    cat <<'EOF'
+=== CHECKPOINT PROTOCOL — MANDATORY ===
+
+You MUST work in micro-steps. Each micro-step:
+
+  1. Makes ONE small change (write one file, modify one function, add one test).
+  2. IMMEDIATELY persists it to disk via apply_patch. Do NOT batch multiple
+     changes into a single apply_patch and do NOT draft code in your
+     response without applying it.
+  3. After the apply_patch succeeds, emit on its own line:
+       ### CHECKPOINT: <terse description of what was just persisted>
+  4. Then start the next micro-step.
+
+A micro-step should complete in under 2 minutes. If you find yourself
+drafting more than ~30 lines of code without an apply_patch + CHECKPOINT
+in between, STOP and persist what you have.
+
+Why this matters: this orchestrator is checkpoint-aware. Each
+### CHECKPOINT line you emit:
+  - Counts as preserved progress (immune to subsequent timeout)
+  - Resets the idle-timeout window (default 120s)
+  - Becomes the starting point if your session is resumed later
+
+If you exceed the idle timeout without a new checkpoint, you WILL be
+killed and the orchestrator may resume from your last checkpoint with a
+RESUME prompt listing your completed checkpoints. So: persist often,
+narrate via CHECKPOINT markers, do not hold work in your head.
+
+Example sequence for a "add structured logging" subtask:
+  1. apply_patch: add structlog dep to pyproject.toml
+     ### CHECKPOINT: added structlog dep
+  2. apply_patch: create src/.../logging.py with empty configure_logging() stub
+     ### CHECKPOINT: module stub created
+  3. apply_patch: add tests/test_logging.py with one failing test
+     ### CHECKPOINT: red test for json output
+  4. apply_patch: fill configure_logging() to pass test 3
+     ### CHECKPOINT: green - json output
+  ... continue until subtask is complete.
+
+=== END CHECKPOINT PROTOCOL ===
+
+YOUR SUBTASK:
+EOF
+}
+
+# Build a RESUME header for a subtask that was killed but had completed
+# checkpoints. The completed list becomes context so the model doesn't
+# redo finished work.
+_tangle_resume_protocol_header() {
+    local completed_list="$1"
+    cat <<EOF
+=== RESUME PROTOCOL ===
+
+Your previous session on this subtask was terminated. The following
+micro-steps were already completed and persisted to disk:
+
+${completed_list}
+
+Continue from where you left off. Do NOT redo any of the completed
+work above. Verify the files on disk match the descriptions if you
+need to confirm state, then proceed with the next micro-step.
+
+The checkpoint protocol still applies — keep emitting
+### CHECKPOINT: <description> after each apply_patch.
+
+=== END RESUME PROTOCOL ===
+
+YOUR SUBTASK:
+EOF
+}
+
+# Kill a tangle subtask cleanly: SIGTERM the wrapper and its descendants,
+# wait briefly, then SIGKILL. Write a `timeout` marker to the .done file
+# so the outer reporting loop counts it as a failed subtask.
+_tangle_kill_subtask() {
+    local wrapper_pid="$1"
+    local task_id="$2"
+    local done_file="$3"
+
+    if [[ -n "$wrapper_pid" ]]; then
+        pkill -TERM -P "$wrapper_pid" 2>/dev/null || true
+        kill -TERM "$wrapper_pid" 2>/dev/null || true
+        sleep 1
+        pkill -KILL -P "$wrapper_pid" 2>/dev/null || true
+        kill -KILL "$wrapper_pid" 2>/dev/null || true
+    fi
+
+    mkdir -p "$(dirname "$done_file")" 2>/dev/null || true
+    if [[ ! -f "$done_file" ]] && ! echo "timeout" > "$done_file" 2>/dev/null; then
+        log WARN "Failed to write timeout marker for ${task_id} at $done_file"
+    fi
+}
+
